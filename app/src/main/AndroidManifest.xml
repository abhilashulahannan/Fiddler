<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.fiddler">

    <!-- Dangerous permissions (require runtime approval) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Call phs5 recent-messages strip — see RecentMessages.kt -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Calendar phs3 module (CalendarPhs3Trigger) — reads upcoming events
         from CalendarContract, merged across every synced calendar account
         (Google, Samsung, Outlook, etc.). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Bluetooth (Android 12+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <!-- Storage permissions for ringtones and media -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- System settings -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- Normal permissions -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="com.android.vending.BILLING" />
    <uses-permission android:name="com.android.vending.CHECK_LICENSE" />

    <!-- For querying installed packages (Android 11+) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Required for overlay/status-bar style views -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Play Install Referrer API, and the Settings tiles' resolveActivity()
         probes (panel-first, falling back to the full settings screen when a
         panel isn't available on this OEM/API level — see handoff.md §4/§6).
         Package-visibility rules (Android 11+) only affect PackageManager
         *query* calls like resolveActivity(), not startActivity() itself, so
         these entries exist purely so the tiles can detect availability
         before firing, not because startActivity would otherwise fail. -->
    <queries>
        <intent>
            <action android:name="com.android.vending.INSTALL_REFERRER_SERVICE" />
        </intent>
        <!-- Wi-Fi -->
        <intent>
            <action android:name="android.settings.panel.action.WIFI" />
        </intent>
        <intent>
            <action android:name="android.settings.WIFI_SETTINGS" />
        </intent>
        <!-- Bluetooth -->
        <intent>
            <action android:name="android.settings.panel.action.BLUETOOTH" />
        </intent>
        <intent>
            <action android:name="android.settings.BLUETOOTH_SETTINGS" />
        </intent>
        <!-- NFC -->
        <intent>
            <action android:name="android.settings.panel.action.NFC" />
        </intent>
        <intent>
            <action android:name="android.settings.NFC_SETTINGS" />
        </intent>
        <!-- Mobile data -->
        <intent>
            <action android:name="android.settings.panel.action.INTERNET_CONNECTIVITY" />
        </intent>
        <intent>
            <action android:name="android.settings.WIRELESS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.DATA_ROAMING_SETTINGS" />
        </intent>
        <!-- Dev Options -->
        <intent>
            <action android:name="android.settings.APPLICATION_DEVELOPMENT_SETTINGS" />
        </intent>
        <!-- Accessibility -->
        <intent>
            <action android:name="android.settings.ACCESSIBILITY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.ACCESSIBILITY_DETAILS_SETTINGS" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.Fiddler">

        <!-- Splash screen (launcher) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Fiddler">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Permissions screen -->
        <activity
            android:name=".PermissionsActivity"
            android:exported="false" />

        <!-- Main app screen -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Network Speed Service (overlay) -->
        <service
            android:name=".subapps.ntspd.NetSpeedService"
            android:exported="false" />

        <!-- Fidland overlay service -->
        <service
            android:name=".subapps.Fidland.service.FidlandService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!--
            Fidland pill accessibility service.
            Purely a window-grant mechanism: TYPE_ACCESSIBILITY_OVERLAY (the
            only overlay window type allowed to draw above the status bar's
            SystemUI layer) is only honored while this app has an ACTIVE
            accessibility service connected. This service does not read or
            act on screen/window content — see FidlandAccessibilityService.kt
            and res/xml/res_accessibility_service_config.xml.
            User must enable it once under Settings > Accessibility.
        -->
        <service
            android:name=".subapps.Fidland.service.FidlandAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/res_accessibility_service_config" />
        </service>

        <!-- Media Notification Listener -->
        <service
            android:name=".subapps.Fidland.NotificationListenerService"
            android:label="Media Listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>